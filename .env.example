# Azure AD App Registration
# Get these from https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
AZURE_CLIENT_ID=your-client-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Microsoft Graph API Scopes
GRAPH_SCOPES=https://graph.microsoft.com/.default

# Authentication cache directory (relative to monorepo root)
CACHE_DIRECTORY=.auth-cache

# Server port (optional, defaults to 3001)
PORT=3001

# Work Schedule Configuration (all optional with defaults)
# Total hours per work week (default: 40)
WORK_HOURS_PER_WEEK=40

# Number of work days per week (default: 5)
WORK_DAYS_PER_WEEK=5

# Comma-separated work days: 0=Sunday, 1=Monday, ..., 6=Saturday (default: 1,2,3,4,5 for Mon-Fri)
WORK_DAYS=1,2,3,4,5

# Work day start hour in 24h format (default: 9)
WORK_START_HOUR=9

# Work day end hour in 24h format (default: 17)
WORK_END_HOUR=17
