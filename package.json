{
  "name": "calendar-whisperer",
  "version": "0.1.0",
  "private": true,
  "description": "Provide insights about time spent in meetings and focus work",
  "scripts": {
    "dev": "pnpm --filter cli dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "web": "concurrently --kill-others \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "pnpm -r build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.10.5",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "uba-eslint-config": "^1.1.1",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
